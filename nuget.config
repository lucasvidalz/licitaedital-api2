<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Feed local da lib proprietaria. E' a pasta para onde `dotnet pack` daquele repositorio manda
      os .nupkg (PackageOutputPath do Directory.Build.props de la) — nao ha passo de copia.
      Caminho relativo a este arquivo: a lib e' pasta irma deste repositorio.
    -->
    <add key="licitaedital-local" value="../LicitaEdital.BuildingBlocks/artifacts" />
  </packageSources>

  <!--
    O mapeamento e' o que impede um pacote nosso ser resolvido do nuget.org por engano — cenario de
    dependency confusion, em que alguem publica `LicitaEdital.BuildingBlocks.Domain` la fora e o
    restore prefere aquele.
  -->
  <packageSourceMapping>
    <packageSource key="licitaedital-local">
      <package pattern="LicitaEdital.BuildingBlocks.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
