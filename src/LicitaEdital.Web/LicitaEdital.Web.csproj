<Project Sdk="Microsoft.NET.Sdk.Web">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.1.3" />

  <PropertyGroup>
    <!--
      MSG0005 do gerador do Mediator: "mensagem sem handler registrado". Sao 3 eventos de dominio
      que ja existem e ainda nao tem consumidor — `OpportunityRefreshedEvent` e
      `OfferingChangedEvent` esperam o motor de compatibilidade (Fase 4 do plano), e
      `MembershipStatusChangedEvent` espera a invalidacao de sessao (Fase 2). O aviso esta certo; o
      que ele nao sabe e' que o consumidor e' trabalho planejado, nao esquecimento.

      **Tire esta linha assim que os tres handlers existirem** — a partir dai o aviso volta a ser
      util: ele pega evento novo que ninguem escuta.
    -->
    <NoWarn>$(NoWarn);MSG0005</NoWarn>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <OutputType>Exe</OutputType>
    <WebProjectMode>true</WebProjectMode>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.ListStartupServices" />
    <PackageReference Include="Ardalis.Result" />
    <PackageReference Include="Ardalis.Result.AspNetCore" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="LicitaEdital.BuildingBlocks.Auth" />
    <PackageReference Include="LicitaEdital.BuildingBlocks.Web" />
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LicitaEdital.Infrastructure\LicitaEdital.Infrastructure.csproj" />
    <ProjectReference Include="..\LicitaEdital.UseCases\LicitaEdital.UseCases.csproj" />
    <!-- Composicao: o Web e' o unico que enxerga os tres, e so para registrar no DI. -->
    <ProjectReference Include="..\LicitaEdital.Query\LicitaEdital.Query.csproj" />
    <ProjectReference Include="..\LicitaEdital.Facade\LicitaEdital.Facade.csproj" />
    <ProjectReference Include="..\LicitaEdital.Providers\LicitaEdital.Providers.csproj" />
    <ProjectReference Include="..\LicitaEdital.ServiceDefaults\LicitaEdital.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
