      Nada mais de Infrastructure e' usado aqui: nenhum repositorio, nenhum contexto de escrita.
    -->
    <ProjectReference Include="..\LicitaEdital.Infrastructure\LicitaEdital.Infrastructure.csproj" />
  </ItemGroup>

