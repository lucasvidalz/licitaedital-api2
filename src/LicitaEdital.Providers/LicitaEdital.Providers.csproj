<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.1.3" />

  <ItemGroup>
    <PackageReference Include="LicitaEdital.BuildingBlocks.Integration" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Implementa os contratos do Facade. `Data` e `Queries` entram porque duas dessas implementacoes
      sao servidas pelo **nosso** banco, nao por sistema externo: `UserAccountService` roda sobre o
      store do ASP.NET Identity e `CatalogFacade` sobre o contexto de leitura de Catalog.

      Consequencia a conhecer: com `Data` ao alcance, a trava que impedia abrir transacao em volta de
      chamada HTTP (spec §14) deixou de ser estrutural e virou disciplina. Provider de sistema
      externo continua sem motivo para tocar DbContext.
    -->
    <ProjectReference Include="..\LicitaEdital.Facade\LicitaEdital.Facade.csproj" />
    <ProjectReference Include="..\LicitaEdital.Data\LicitaEdital.Data.csproj" />
    <ProjectReference Include="..\LicitaEdital.Queries\LicitaEdital.Queries.csproj" />
  </ItemGroup>

</Project>
