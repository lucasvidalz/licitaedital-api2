{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    // PostgreSQL local em container, sem senha (`POSTGRES_HOST_AUTH_METHOD=trust`):
    //   docker run -d --name licitaedital-postgres -e POSTGRES_HOST_AUTH_METHOD=trust \
    //     -e POSTGRES_USER=postgres -e POSTGRES_DB=licitaedital -p 5434:5432 \
    //     --restart unless-stopped postgres:17-alpine
    //
    // Porta 5434, e nao 5432: nesta maquina a 5432 e' do PostgreSQL do sistema e a 5433 e' de
    // outro projeto. Subindo pelo AspireHost, a connection string vem dele e esta aqui e' ignorada.
    "licitaedital": "Host=localhost;Port=5434;Database=licitaedital;Username=postgres"
  },
  "Cors": {
    // O caminho **normal** do dev nao passa por aqui: o `ng serve` encaminha `/api` para esta API
    // por `proxy.conf.json`, entao frontend e API tem a mesma origem e CORS nem entra em cena. Esta
    // entrada cobre quem rodar o Angular apontando direto para `http://localhost:8080`, e existe
    // porque a politica da lib nao libera ninguem com a lista vazia. Com sessao por cookie nao ha
    // curinga possivel: `AllowAnyOrigin` e' incompativel com `AllowCredentials`.
    //
    // Note que apontar direto **desliga o XSRF** sem avisar: o interceptor do Angular so' anexa o
    // `X-XSRF-TOKEN` em URL de mesma origem. Use o proxy.
    "Origins": [ "http://localhost:4200" ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  }
}
